{
  "manifest_version": 3,
  "name": "__MSG_eklentiAdi__",
  "description": "__MSG_eklentiAciklamasi__",
  "version": "1.6.0",
  "default_locale": "tr",
  "icons": {
    "16": "icons/ikon16.png",
    "32": "icons/ikon32.png",
    "48": "icons/ikon48.png",
    "128": "icons/ikon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "offscreen",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "src/arka_plan.js",
    "scripts": [
      "src/arka_plan.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_eklentiAdi__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/ikon16.png",
      "32": "icons/ikon32.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/ayarlar.js",
        "src/base64.js",
        "src/dil.js",
        "src/dilimleme.js",
        "src/diller.js",
        "src/icerik/aday.js",
        "src/icerik/ana.js",
        "src/icerik/gorunum.js",
        "src/icerik/mesaj.js",
        "src/icerik/resim_al.js",
        "src/icerik/sigdir.js",
        "src/isaretler.js",
        "src/kutu_oturtma.js",
        "src/kuyruk.js",
        "src/tarayici.js",
        "src/yz/katalog.js",
        "src/yz/ortak.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "orijinal-ceviri": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "__MSG_kisayolAciklamasi__"
    }
  },
  "minimum_chrome_version": "120",
  "browser_specific_settings": {
    "gecko": {
      "id": "manga-cevirmen@enesilhan1",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      }
    }
  }
}
